{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "battle-royale-worker",
  "main": "js/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  "durable_objects": {
    "bindings": [
      {
        "name": "MATCH_DO",
        "class_name": "MatchDO"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MatchDO"]
    }
  ],

  "vars": {
    "ENVIRONMENT": "development"
  }
}
